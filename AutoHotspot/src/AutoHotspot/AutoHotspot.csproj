<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AutoHotspot</AssemblyName>
    <RootNamespace>AutoHotspot</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyTitle>AutoHotspot</AssemblyTitle>
    <Description>Starts the current user's Windows mobile hotspot after sign-in.</Description>
    <Company>AutoHotspot</Company>
    <Product>AutoHotspot</Product>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
  </ItemGroup>
</Project>
