### 6\. C++ Program

The following program implements all the main operations mentioned in your practical sheet. It supports BST creation, three traversals, height calculation, depth calculation, leaf-node counting and internal-node counting.

COMPLETE PROGRAM — C++

```cpp

#include <iostream>
#include <algorithm>
using namespace std;

// Structure of a tree node
struct Node
{
    int data;
    Node *left, *right;
};

// Create a new node
Node* createNode(int value)
{
    Node* newNode = new Node;
    newNode->data = value;
    newNode->left = newNode->right = NULL;
    return newNode;
}

// Insert a node into BST
Node* insert(Node* root, int value)
{
    if (root == NULL)
        return createNode(value);

    if (value < root->data)
        root->left = insert(root->left, value);

    else if (value > root->data)
        root->right = insert(root->right, value);

    return root;
}

// In-order Traversal
void inorder(Node* root)
{
    if (root == NULL)
        return;

    inorder(root->left);
    cout << root->data << " ";
    inorder(root->right);
}

// Pre-order Traversal
void preorder(Node* root)
{
    if (root == NULL)
        return;

    cout << root->data << " ";
    preorder(root->left);
    preorder(root->right);
}

// Post-order Traversal
void postorder(Node* root)
{
    if (root == NULL)
        return;

    postorder(root->left);
    postorder(root->right);
    cout << root->data << " ";
}

// Find height of tree (in edges)
int height(Node* root)
{
    if (root == NULL)
        return -1;

    int leftHeight = height(root->left);
    int rightHeight = height(root->right);

    return 1 + max(leftHeight, rightHeight);
}

// Find depth of a node
int findDepth(Node* root, int value, int depth = 0)
{
    if (root == NULL)
        return -1;

    if (root->data == value)
        return depth;

    if (value < root->data)
        return findDepth(root->left, value, depth + 1);

    return findDepth(root->right, value, depth + 1);
}

// Count leaf nodes
int countLeaf(Node* root)
{
    if (root == NULL)
        return 0;

    if (root->left == NULL && root->right == NULL)
        return 1;

    return countLeaf(root->left) +
           countLeaf(root->right);
}

// Count internal nodes
int countInternal(Node* root)
{
    if (root == NULL)
        return 0;

    if (root->left == NULL && root->right == NULL)
        return 0;

    return 1 + countInternal(root->left) +
           countInternal(root->right);
}

// Main function
int main()
{
    Node* root = NULL;
    int n, value, target;

    cout << "Enter number of nodes: ";
    cin >> n;

    cout << "Enter node values: ";

    for (int i = 0; i < n; i++)
    {
        cin >> value;
        root = insert(root, value);
    }

    cout << "\nIn-order Traversal: ";
    inorder(root);

    cout << "\nPre-order Traversal: ";
    preorder(root);

    cout << "\nPost-order Traversal: ";
    postorder(root);

    cout << "\nHeight of Tree: "
         << height(root);

    cout << "\nEnter node to find depth: ";
    cin >> target;

    int depth = findDepth(root, target);

    if (depth == -1)
        cout << "Node not found";
    else
        cout << "Depth of Node: " << depth;

    cout << "\nLeaf Nodes: "
         << countLeaf(root);

    cout << "\nInternal Nodes: "
         << countInternal(root);

    return 0;
}
```

Important note about height: Your handwritten notes define height as the number of edges in the longest root-to-leaf path. This program follows that definition, so an empty tree has height -1 and a single-node tree has height 0. Your algorithm notes use 0 for an empty tree, which instead calculates height in nodes. Both conventions are valid, but the program uses the edge-based definition from your theory.

Important note about duplicate values: This program ignores duplicate values because a standard BST implementation generally stores unique keys unless a separate duplicate-handling rule is defined.

