# 이 파일은 **이름만** 적는 견본이다. 값을 채워 넣지 말 것 —
# 채운 사본은 .env 로 두면 .gitignore 가 막는다.
#
#   cp competition/.env.example competition/.env
#   # .env 에 값을 채운 뒤
#   set -a && . competition/.env && set +a
#
# 코드는 전부 os.environ 으로만 읽는다(src/aihub.py, src/fetch_622.py).
# 소스에 키를 적어 넣은 곳은 없고, 커밋 이력에도 들어간 적이 없다.

# AI Hub — 마이페이지에서 발급. 다운로드는 국내 IP 전용이다(docs/AIHUB.md §7).
AIHUB_APIKEY=

# 케글 — kaggle.com/settings 에서 API 토큰 생성.
# ~/.kaggle/kaggle.json 을 쓰는 경로도 있으니 그쪽을 쓰면 아래는 비워 둔다.
KAGGLE_USERNAME=
KAGGLE_KEY=
