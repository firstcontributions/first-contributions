### 4\. C++ Program

C++ – Backtracking

The uploaded practical sheet does not contain the actual program code. The following is a standard C++ implementation based on the algorithm given in your manual.

```cpp

#include <iostream>
#include <vector>
using namespace std;

// Check whether a queen can be placed safely
bool isSafe(vector<string>& board, int row, int col, int n)
{
    // Check the same column
    for (int i = 0; i < row; i++)
    {
        if (board[i][col] == 'Q')
            return false;
    }

    // Check upper-left diagonal
    for (int i = row - 1, j = col - 1;
         i >= 0 && j >= 0; i--, j--)
    {
        if (board[i][j] == 'Q')
            return false;
    }

    // Check upper-right diagonal
    for (int i = row - 1, j = col + 1;
         i >= 0 && j < n; i--, j++)
    {
        if (board[i][j] == 'Q')
            return false;
    }

    return true;
}

// Solve the N-Queen problem using backtracking
bool solveNQueen(vector<string>& board, int row, int n)
{
    // All queens are placed successfully
    if (row == n)
        return true;

    // Try every column in the current row
    for (int col = 0; col < n; col++)
    {
        if (isSafe(board, row, col, n))
        {
            // Place the queen
            board[row][col] = 'Q';

            // Move to the next row
            if (solveNQueen(board, row + 1, n))
                return true;

            // Backtrack by removing the queen
            board[row][col] = '.';
        }
    }

    return false;
}

int main()
{
    int n;

    cout << "Enter the number of queens: ";
    cin >> n;

    if (n <= 0)
    {
        cout << "Invalid input!";
        return 0;
    }

    vector<string> board(n, string(n, '.'));

    if (solveNQueen(board, 0, n))
    {
        cout << "Solution:\n";

        for (int i = 0; i < n; i++)
        {
            for (int j = 0; j < n; j++)
            {
                cout << board[i][j] << " ";
            }
            cout << endl;
        }
    }
    else
    {
        cout << "No solution exists.";
    }

    return 0;
}
```

Symbols used in the program:

* `Q` – Represents a queen placed on the chessboard.

* `.` – Represents an empty position.

* `isSafe()` – Checks whether a position is safe.

* `solveNQueen()` – Places queens recursively using backtracking.

